{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "name": "LM Studio",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://host.docker.internal:1234/v1"
      },
      "models": {
        "gemma-4-e4b": {
          "name": "google/gemma-4-e4b",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "gemma-4-e2b": {
          "name": "google/gemma-4-e2b",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "qwen3.5-9b": {
          "name": "qwen/qwen3.5-9b",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    },
    "omniroute": {
      "name": "OmniRoute",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://host.docker.internal:20128/v1",
        "apiKey": "sk_omniroute"
      },
      "models": {
        "auto": {
          "name": "Auto (OmniRoute)"
        },
        "free-stack": {
          "name": "free-stack"
        },
        "last_work_models_lite": {
          "name": "last_work_models_lite"
        },
        "last_work_models_pro": {
          "name": "last_work_models_pro"
        },
        "auto/pro-coding": {
          "name": "auto/pro-coding"
        },
        "auto/best-free": {
          "name": "auto/best-free"
        },
        "auto/best-coding": {
          "name": "auto/best-coding"
        },
        "auto/best-coding-fast": {
          "name": "auto/best-coding-fast"
        }
      }
    }
  },
  "model": "omniroute/auto"
}