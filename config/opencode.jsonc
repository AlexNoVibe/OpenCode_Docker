{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "name": "LM Studio",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://host.docker.internal:1234/v1"
      },
      "models": {
        "gemma-4-e4b": {
          "name": "google/gemma-4-e4b",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "gemma-4-e2b": {
          "name": "google/gemma-4-e2b",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "qwen3.5-9b": {
          "name": "qwen/qwen3.5-9b",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    },
    "omniroute": {
      "name": "OmmmmmniRoute",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://host.docker.internal:20128/v1",
        "apiKey": "sk_omniroute"
      },
  "models": {
    "auto": {
      "name": "auto/best-free",
      "limit": {
        "context": 256000,
        "output": 32192
      }
    },
    "free-stack": {
      "name": "free-stack",
      "limit": {
        "context": 256000,
        "output": 32192
      }
    },
    "last_work_models_lite": {
      "name": "last_work_models_lite",
      "limit": {
        "context": 256000,
        "output": 32192
      }
    },
    "last_work_models_pro": {
      "name": "last_work_models_pro",
      "limit": {
        "context": 256000,
        "output": 32192
      }
    },
    "auto/pro-coding": {
      "name": "auto/pro-coding",
      "limit": {
        "context": 256000,
        "output": 32192
      }
    },
    "auto/best-free": {
      "name": "auto/best-free",
      "limit": {
        "context": 256000,
        "output": 32192
      }
    },
    "auto/best-coding": {
      "name": "auto/best-coding",
      "limit": {
        "context": 256000,
        "output": 32192
      }
    },
    "auto/best-coding-fast": {
      "name": "auto/best-coding-fast",
      "limit": {
        "context": 256000,
        "output": 32192
      }
    }
  }    
  }
  },
  "model": "omniroute/auto"
}